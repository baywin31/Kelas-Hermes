:root{
  /* Palet dari user: biru langit #A4D8FF + abu arang #35393C.
     Abu arang dipakai sebagai permukaan (dinaik-turunkan kecerahannya supaya
     ada kedalaman), biru langit sebagai satu-satunya warna kromatik. */
  --bg:#25282b;
  --bg-soft:#2b2f32;
  --panel:rgba(164,216,255,.035);
  --panel2:rgba(164,216,255,.07);
  --panel3:rgba(164,216,255,.10);
  --line:rgba(164,216,255,.14);
  --line-soft:rgba(164,216,255,.08);

  /* teks: bertingkat, bukan putih polos */
  --fg:#f2f7fc;
  --fg2:#cfdae5;
  --muted:#94a3af;
  --muted2:#6d7883;

  /* satu-satunya warna kromatik */
  --accent:#A4D8FF;
  --accent2:#BFE4FF;
  --accent3:#8CCBFA;
  --ok:#7fd8b5;
  --danger:#ff9b9e;
  --warn:#f5c97a;
  --tele:#A4D8FF;

  /* teks di atas tombol biru langit — biru itu terang, jadi tulisannya gelap */
  --on-accent:#22262a;

  --r-s:6px; --r-m:8px; --r-l:12px; --r-xl:16px;
  --shadow:0 1px 2px rgba(0,0,0,.28), 0 8px 24px -12px rgba(0,0,0,.55);
  --ring:0 0 0 1px var(--accent2), 0 0 0 4px rgba(164,216,255,.22);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--bg); color:var(--fg2);
  font-family:'Inter',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-feature-settings:"cv01","ss03"; font-size:15px; line-height:1.6;
  -webkit-font-smoothing:antialiased; -webkit-text-size-adjust:100%;
  background-image:radial-gradient(900px 420px at 50% -180px, rgba(94,106,210,.14), transparent 70%);
  background-repeat:no-repeat;
}
.wrap{width:100%; max-width:940px; margin:0 auto; padding:0 20px}
.wrap.lebar{max-width:1240px}
a{color:var(--accent3); text-decoration:none; transition:color .15s}
a:hover{color:#a3adff; text-decoration:none}
.skip{position:absolute;left:-9999px}
.skip:focus{left:12px;top:12px;background:var(--accent);color:var(--on-accent);padding:10px 14px;border-radius:var(--r-m);z-index:99}
::selection{background:rgba(164,216,255,.34); color:var(--on-accent)}

/* ---------- topbar ---------- */
.topbar{
  position:sticky; top:0; z-index:20;
  border-bottom:1px solid var(--line-soft);
  background:rgba(8,9,10,.72); backdrop-filter:saturate(160%) blur(14px);
}
.bar{display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:60px; flex-wrap:wrap}
.brand{display:flex; flex-direction:column; gap:1px; color:var(--fg)}
.brand strong{font-size:15px; font-weight:600; letter-spacing:-.24px; color:var(--fg)}
.brand .tag{color:var(--muted2); font-size:11.5px; letter-spacing:-.1px}
.nav{display:flex; gap:2px; flex-wrap:wrap; align-items:center}
.nav a{
  color:var(--muted); padding:8px 11px; border-radius:var(--r-s);
  font-size:13.5px; font-weight:510; letter-spacing:-.14px;
  min-height:36px; display:inline-flex; align-items:center;
  transition:background .15s, color .15s;
}
.nav a:hover{background:var(--panel2); color:var(--fg)}
.nav a.pill{background:var(--accent); color:var(--on-accent)}
.nav a.pill:hover{background:var(--accent2); color:var(--on-accent)}

/* ---------- kartu ---------- */
main{padding:36px 0 72px}
.card{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--r-l);
  padding:26px 24px; margin-bottom:16px;
}
.card.tight{padding:18px}

/* ---------- hero halaman depan ---------- */
.hero{padding:26px 0 34px; text-align:center}
.eyebrow{
  display:inline-block; padding:4px 11px; margin-bottom:18px;
  border:1px solid rgba(113,112,255,.3); border-radius:999px;
  background:rgba(113,112,255,.09); color:#b3b9ff;
  font-size:11.5px; font-weight:510; letter-spacing:.2px;
}
.hero h1{font-size:44px; letter-spacing:-1.4px; line-height:1.05; margin:0 0 14px}
.hero .sub{max-width:560px; margin:0 auto 26px}
.hero-aksi{display:flex; gap:10px; justify-content:center; flex-wrap:wrap}
.hero-aksi .btn{min-height:42px; padding:11px 20px; font-size:14px}

/* ---------- grid fitur ---------- */
.fitur{display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; margin-top:16px}
.fitur-item{
  border:1px solid var(--line); border-radius:var(--r-m);
  background:var(--panel); padding:18px;
  transition:background .15s, border-color .15s;
}
.fitur-item:hover{background:var(--panel2); border-color:rgba(255,255,255,.12)}
.fitur-item b{display:block; font-size:14px; font-weight:590; letter-spacing:-.2px; color:var(--fg); margin-bottom:5px}
.fitur-item span{display:block; font-size:13px; letter-spacing:-.13px; color:var(--muted)}

h1{font-size:30px; font-weight:510; letter-spacing:-.9px; line-height:1.15; margin:0 0 8px; color:var(--fg)}
h2{font-size:19px; font-weight:590; letter-spacing:-.32px; margin:28px 0 10px; color:var(--fg)}
h3{font-size:16px; font-weight:590; letter-spacing:-.2px; margin:20px 0 6px; color:var(--fg)}
.sub{color:var(--muted); font-size:15px; letter-spacing:-.16px; margin:0 0 20px}
.muted{color:var(--muted)}
.small{font-size:13px; letter-spacing:-.13px}
p{margin:0 0 12px}

/* ---------- tombol ---------- */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  min-height:38px; padding:9px 16px; border-radius:var(--r-s);
  border:1px solid transparent; background:var(--accent); color:var(--on-accent);
  font-family:inherit; font-size:13.5px; font-weight:590; letter-spacing:-.14px;
  cursor:pointer; transition:background .15s, border-color .15s, color .15s, transform .06s;
}
.btn:hover{background:var(--accent2); color:var(--on-accent)}
.btn:active{transform:translateY(1px)}
.btn:focus-visible{outline:none; box-shadow:var(--ring)}
.btn.ghost{background:var(--panel2); border-color:var(--line); color:var(--fg)}
.btn.ghost:hover{background:var(--panel3); border-color:rgba(164,216,255,.24); color:var(--fg)}
.btn.ok{background:transparent; border-color:rgba(127,216,181,.45); color:var(--ok)}
.btn.ok:hover{background:rgba(16,185,129,.12); color:#6ee7b7}
.btn.danger{background:transparent; border-color:rgba(242,85,90,.4); color:#ff8b8f}
.btn.danger:hover{background:rgba(242,85,90,.12); color:#ffa8ab}
.btn.blok{width:100%}
.btn:disabled{opacity:.45; cursor:not-allowed}
.btn-tele{background:var(--tele); min-height:44px; font-size:14.5px; font-weight:590}
.btn-tele:hover{background:#2fb0e8}

/* ---------- form ---------- */
label{display:block; margin:16px 0 6px; font-size:13px; font-weight:510; letter-spacing:-.13px; color:var(--fg2)}
input,textarea,select{
  width:100%; padding:10px 13px; min-height:40px;
  font-family:inherit; font-size:14px; letter-spacing:-.14px;
  background:rgba(255,255,255,.02); color:var(--fg);
  border:1px solid var(--line); border-radius:var(--r-s);
  transition:border-color .15s, box-shadow .15s, background .15s;
}
input::placeholder,textarea::placeholder{color:var(--muted2)}
input:hover,textarea:hover,select:hover{border-color:rgba(255,255,255,.14)}
input:focus,textarea:focus,select:focus{outline:none; background:rgba(255,255,255,.03); box-shadow:var(--ring); border-color:transparent}
textarea{min-height:190px; resize:vertical; line-height:1.6}
.hint{color:var(--muted2); font-size:12.5px; letter-spacing:-.12px; margin-top:7px}
.kode-input{
  font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace;
  letter-spacing:2.5px; text-transform:uppercase; font-size:17px; text-align:center; min-height:50px;
}
.row{display:flex; gap:12px; flex-wrap:wrap}
.row>*{flex:1 1 200px}

/* ---------- flash ---------- */
.flash{
  padding:12px 15px; border-radius:var(--r-m); margin-bottom:18px;
  border:1px solid; font-size:13.5px; letter-spacing:-.14px;
}
.flash.ok{background:rgba(16,185,129,.09); border-color:rgba(16,185,129,.28); color:#6ee7b7}
.flash.err{background:rgba(242,85,90,.09); border-color:rgba(242,85,90,.28); color:#ffa8ab}
.flash.info{background:rgba(113,112,255,.09); border-color:rgba(113,112,255,.28); color:#b3b9ff}

/* ---------- daftar bagian ---------- */
.bagian{
  display:flex; gap:16px; align-items:flex-start; padding:16px;
  border:1px solid var(--line-soft); border-radius:var(--r-m);
  background:rgba(255,255,255,.018); margin-bottom:10px;
  transition:background .15s, border-color .15s;
}
.bagian:hover{background:var(--panel2); border-color:var(--line)}
.bagian .no{
  flex:0 0 32px; height:32px; border-radius:var(--r-s);
  background:rgba(94,106,210,.16); border:1px solid rgba(113,112,255,.28); color:#b3b9ff;
  display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:590; font-variant-numeric:tabular-nums;
}
.bagian .isi{flex:1 1 auto; min-width:0}
.bagian .isi h3{margin:0 0 3px; font-size:15px; font-weight:590; letter-spacing:-.2px}
.bagian .isi h3 a{color:var(--fg)}
.bagian .isi h3 a:hover{color:var(--accent3)}
.bagian .aksi{flex:0 0 auto; display:flex; flex-direction:column; gap:7px; align-items:flex-end}
.badge{
  display:inline-block; padding:2px 8px; border-radius:999px;
  font-size:11px; font-weight:510; letter-spacing:.1px; border:1px solid; vertical-align:middle;
}
.badge.baru{background:rgba(245,166,35,.12); color:#f8c15f; border-color:rgba(245,166,35,.3)}
.badge.selesai{background:rgba(16,185,129,.1); color:#5fd6a4; border-color:rgba(16,185,129,.28)}
.badge.mulai{background:rgba(113,112,255,.12); color:#b3b9ff; border-color:rgba(113,112,255,.3)}
.badge.belum{background:transparent; color:var(--muted2); border-color:var(--line)}

/* ---------- progres ---------- */
.progres{margin:4px 0 0}
.progres-angka{display:flex; align-items:baseline; gap:10px; margin-bottom:12px}
.progres-angka b{
  font-size:32px; font-weight:510; letter-spacing:-1px; line-height:1;
  color:var(--fg); font-variant-numeric:tabular-nums;
}
.bar-luar{height:6px; background:rgba(255,255,255,.06); border-radius:999px; overflow:hidden}
.bar-dalam{height:100%; width:0; border-radius:999px;
  background:linear-gradient(90deg,var(--accent),var(--accent3)); transition:width .5s cubic-bezier(.4,0,.2,1)}

/* ---------- materi ---------- */
.materi{display:grid; grid-template-columns:212px 1fr; gap:36px; align-items:start}
.toc{position:sticky; top:80px; border-left:1px solid var(--line); padding:2px 0 2px 16px}
.toc a{display:block; color:var(--muted); font-size:13px; font-weight:510; letter-spacing:-.13px; padding:5px 0}
.toc a:hover{color:var(--fg)}
.toc a.l3{padding-left:12px; font-size:12.5px; font-weight:400}
.isi-materi{min-width:0; color:var(--fg2); font-size:15.5px; line-height:1.75}
.isi-materi h2{margin-top:36px}
.isi-materi img{max-width:100%; border-radius:var(--r-m); border:1px solid var(--line)}
.isi-materi pre{
  background:#0c0d0f; border:1px solid var(--line); border-radius:var(--r-m);
  padding:15px 16px; overflow-x:auto; font-size:13px; line-height:1.65;
}
.isi-materi code{
  font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace;
  background:rgba(255,255,255,.06); border:1px solid var(--line-soft);
  border-radius:4px; padding:1.5px 5px; font-size:13px; color:#e6c9a8;
}
.isi-materi pre code{border:0; padding:0; background:none; color:var(--fg2)}
.isi-materi blockquote{
  margin:18px 0; padding:2px 0 2px 18px;
  border-left:2px solid var(--accent2); color:var(--muted); font-style:normal;
}
.isi-materi table{width:100%; border-collapse:collapse; margin:18px 0; font-size:14px}
.isi-materi th,.isi-materi td{border-bottom:1px solid var(--line); padding:10px 12px; text-align:left}
.isi-materi th{color:var(--muted); font-size:12px; font-weight:590; text-transform:uppercase; letter-spacing:.4px}
.isi-materi ul,.isi-materi ol{padding-left:22px}
.isi-materi li{margin:5px 0}
.isi-materi hr{border:0; border-top:1px solid var(--line); margin:32px 0}

/* ---------- tabel admin ---------- */
table.data{width:100%; border-collapse:collapse; font-size:13.5px}
table.data th,table.data td{border-bottom:1px solid var(--line-soft); padding:11px 10px; text-align:left}
table.data th{
  color:var(--muted2); font-weight:590; font-size:11px;
  text-transform:uppercase; letter-spacing:.5px; white-space:nowrap;
}
table.data tr:hover td{background:var(--panel2)}
.mono{font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace; font-size:13px; letter-spacing:-.2px}
.stat{display:grid; grid-template-columns:repeat(auto-fit,minmax(158px,1fr)); gap:12px; margin-bottom:22px}
.stat .box{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--r-m); padding:16px 18px;
  transition:background .15s, border-color .15s;
}
.stat .box:hover{background:var(--panel2); border-color:rgba(255,255,255,.12)}
.stat .box b{
  display:block; font-size:26px; font-weight:510; letter-spacing:-.7px;
  color:var(--fg); line-height:1.2; font-variant-numeric:tabular-nums;
}
.stat .box span{color:var(--muted2); font-size:12px; font-weight:510; letter-spacing:-.12px}

/* ---------- footer ---------- */
.footer{
  border-top:1px solid var(--line-soft); color:var(--muted2);
  font-size:12.5px; letter-spacing:-.13px; padding:22px 0 40px;
}
.footer .sep{margin:0 8px; opacity:.5}

/* ---------- responsif ---------- */
@media (max-width:860px){
  .materi{grid-template-columns:1fr; gap:22px}
  .toc{position:static; border-left:0; border-bottom:1px solid var(--line); padding:0 0 12px}
}
@media (max-width:560px){
  body{font-size:14.5px}
  main{padding:24px 0 56px}
  .card{padding:20px 17px}
  h1{font-size:24px; letter-spacing:-.6px}
  .bagian{flex-wrap:wrap}
  .bagian .aksi{width:100%; flex-direction:row; justify-content:flex-start}
  .bar{min-height:54px}
}

/* ---------- halaman cetak ---------- */
@media print{
  .topbar,.footer,.nav,.btn,.toc,.skip,.flash{display:none !important}
  body{background:#fff; color:#000; background-image:none; font-size:11pt}
  .card{border:0; padding:0; background:none; margin:0}
  h1,h2,h3{color:#000}
  a{color:#000; text-decoration:underline}
  .isi-materi{color:#000}
  .isi-materi pre,.isi-materi code{background:#f4f4f4; border:1px solid #ccc; color:#000}
  .wrap{max-width:none; padding:0}
}
